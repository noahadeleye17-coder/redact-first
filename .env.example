# Firebase web app config (Project settings > Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check for the web playground (reCAPTCHA Enterprise site key).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token for the Chrome extension and local dev.
# Keep this in .env.local only. Never commit it.
VITE_APPCHECK_DEBUG_TOKEN=
